    {
      "id": "01_foundation_combat",
      "title": "Foundation combat",
      "purpose": "Learn movement, aiming, projectile avoidance, basic burst fire, death/respawn timing.",
      "mode": "ffa",
      "maps": ["dungeon"],
      "agents": 2,
      "seconds": 45,
      "scripted_smoke_matches": 64,
      "target_env_steps": 15000000,
      "opponents": {"scripted": 0.80, "self_play_current": 0.20},
      "success": {
        "scripted_hard_win_rate": 0.65,
        "mean_damage_per_death": 80,
        "max_environment_death_rate": 0.08
      }
    },
    {
      "id": "02_energy_discipline",
      "title": "Energy discipline",
