# ============================================================
# Pulse Arena — local artifacts that must NEVER enter the repo
# ============================================================

# ---- Python environments & caches ----
.conda/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
*.orig

# ---- Local configuration & secrets ----
.env
.env.*
!.env.example
training/configs/local_settings.json

# ---- Local agent / IDE / tool caches ----
.agents/
.claude/
.gemini/
.codex/
.superpowers/
.worktrees/
.idea/
.vscode/
.DS_Store
Thumbs.db
docs/skills/

# ---- Onboarding handoff docs (personal walkthrough, not for the repo) ----
docs/onboarding-from-zero.md

# ---- Godot & local toolchains ----
.godot/
.godot_user/
.tools/
training/artifacts/godot_user/

# ---- Generated outputs (build / logs / cache) ----
dist/
build/*
!build/.gdignore
tmp/
logs/
test-results/
*.log
training/artifacts/packages/

# ---- Training artifacts (large binaries, replays, metrics) ----
training/artifacts/runs/*
!training/artifacts/runs/.gdignore
training/artifacts/checkpoints/
training/swanlab/
training/data_cache/
training/eval_results/
training/data/replays/*
!training/data/replays/.gitkeep
training/replays_decision/
training/data/incoming_models/
training/data/experiments/

# ---- Model / checkpoint / archive binaries ----
*.onnx
*.pt
*.pth
*.ckpt
*.zip
*.tar
*.tar.gz
*.tgz
*.swanlab*

# ---- Archived legacy raw-action AI artifacts (read-only) ----
archive/**/runs/
archive/**/replays/
archive/**/checkpoints/
archive/**/packages/
archive/**/*.log
archive/**/*.import
archive/**/*.png
archive/**/*.swanlab*
archive/**/*.translation

# ---- LaTeX compilation auxiliaries ----
# keep main.tex / main.pdf / *.bib tracked; only ignore transient build files
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.fdb_latexmk
docs/paper/*.fls
docs/paper/*.log
docs/paper/*.out
docs/paper/*.toc
docs/paper/*.xdv

archive/
